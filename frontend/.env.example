# ==============================================================================
# AgentBreaker Frontend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to customize your frontend connection endpoints.
# NEVER commit .env.local to version control.
#
# IMPORTANT SECURITY NOTE:
# Variables prefixed with NEXT_PUBLIC_ are inlined into client-side JavaScript
# and are publicly readable in the browser. NEVER place API secrets, tokens,
# or private keys in this file.
# ==============================================================================

# Backend Local FastAPI HTTP REST Base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend Local FastAPI WebSocket Base URL (Real-time telemetry & events)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

