# ==============================================================================
# AgentBreaker - Comprehensive Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local environment.
# NEVER commit .env or live credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ENGINE & CLI CONFIGURATION (Backend Only)
# Loaded by pydantic-settings in src/agentbreaker/core/config.py
# Prefix: AGENTBREAKER_
# ------------------------------------------------------------------------------

# Default Target Connection Settings (used when target is not specified via CLI/API)
AGENTBREAKER_TARGET_URL=http://localhost:8000/v1
AGENTBREAKER_TARGET_TYPE=openai_compatible
AGENTBREAKER_TARGET_MODEL=default-model

# Target Authentication (optional depending on target)
AGENTBREAKER_API_KEY=
AGENTBREAKER_AUTH_HEADER_NAME=Authorization

# Execution & Safety Boundaries
AGENTBREAKER_REQUEST_TIMEOUT_SECONDS=30.0
AGENTBREAKER_MAX_CONCURRENCY=5
AGENTBREAKER_RATE_LIMIT_RPS=10.0
AGENTBREAKER_MAX_RETRIES=2
AGENTBREAKER_RETRY_BACKOFF_SECONDS=1.0

# Storage & Reporting Paths
# AGENTBREAKER_HOME sets custom base directory for targets, assessments, and results.
# AGENTBREAKER_HOME=.agentbreaker
AGENTBREAKER_OUTPUT_DIR=reports
AGENTBREAKER_LOG_LEVEL=INFO

# Optional Cloud Provider Keys (for direct provider integrations)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. LOCAL FASTAPI DAEMON CONFIGURATION (Backend Only)
# Loaded by pydantic-settings in src/agentbreaker/api/config.py
# Prefix: AGENTBREAKER_API_
# ------------------------------------------------------------------------------

# Daemon Network Binding (strictly keep loopback 127.0.0.1 for local security)
AGENTBREAKER_API_HOST=127.0.0.1
AGENTBREAKER_API_PORT=8000

# Allowed Host Header list for DNS Rebinding Protection (JSON array format)
AGENTBREAKER_API_TRUSTED_HOSTS=["127.0.0.1","localhost","testserver"]

# CORS Origin Whitelist for Local Frontend Access (JSON array format)
AGENTBREAKER_API_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# Maximum permitted HTTP request payload size in bytes (10MB default)
AGENTBREAKER_API_MAX_REQUEST_SIZE_BYTES=10485760

# Optional Pre-Shared API Token for Local Defense-in-Depth Authorization
# Leave empty for unauthenticated loopback mode. When set, requests must pass
# header 'X-AgentBreaker-Token' or 'Authorization: Bearer <token>'
AGENTBREAKER_API_LOCAL_API_KEY=

# OpenAPI Documentation Toggle (true / false)
AGENTBREAKER_API_DOCS_ENABLED=true

# ------------------------------------------------------------------------------
# 3. FRONTEND NEXT.JS WORKSTATION CONFIGURATION (Public Client-Side)
# Consumed by Next.js in frontend/src/lib/api/client.ts
# Prefix: NEXT_PUBLIC_ (Bundled into browser JavaScript — NEVER put secrets here!)
# ------------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
